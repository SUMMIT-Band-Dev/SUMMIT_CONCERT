# 공개 사이트(저장소 루트) 환경변수. 실제 값은 .env.local에만 넣는다. 이 파일은 커밋된다.

# Supabase 프로젝트 URL과 anon 키. 브라우저에 노출되는 공개 값이며 RLS로 읽기만 허용된다.
# service_role 키나 secret 키를 넣지 않는다.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# 네이버 클라우드 Maps Application의 Client ID. 오시는 길 지도에 쓰며 Client Secret은 넣지 않는다.
NEXT_PUBLIC_NAVER_MAP_CLIENT_ID=

# /api/revalidate 호출을 검증하는 서버 전용 값. apps/api의 REVALIDATE_SECRET과 같은 값을 쓴다.
REVALIDATE_SECRET=
