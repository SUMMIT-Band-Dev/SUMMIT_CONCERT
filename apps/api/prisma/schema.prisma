// 접속 URL은 prisma.config.ts에서 주입한다 (Prisma 7 규약).
//
// 실제 DB는 테이블명에 공백("Line Up")이 있고 컬럼 케이스가 뒤섞여 있다
// (team_name/image_src는 snake_case, teamId/performanceOrder는 camelCase).
// Prisma 쪽 이름은 PRD 데이터 모델 기준 camelCase로 통일하고,
// 실제 컬럼명과의 차이는 @map/@@map으로만 흡수한다 — DB는 건드리지 않는다.

generator client {
  provider               = "prisma-client"
  output                 = "../src/generated/prisma"
  generatedFileExtension = "ts"
  importFileExtension    = "js"
  moduleFormat           = "esm"
  runtime                = "nodejs"
}

datasource db {
  provider = "postgresql"
}

/// 관리자 계정. 방문자용 서비스 로그인과 무관한 관리자 전용 인증 (PRD F001).
model AdminUser {
  id           BigInt @id @default(autoincrement())
  username     String @unique
  passwordHash String
}

/// 공연 팀. RLS 활성화 상태이며 anon key에는 SELECT 정책만 열려 있다.
model LineUp {
  id               BigInt    @id(map: "setlist_pkey") @default(autoincrement())
  teamName         String    @map("team_name")
  day              String?
  cardImageUrl     String?   @map("image_src")
  performanceOrder Int?      @db.SmallInt
  songs            Setlist[]

  @@map("Line Up")
}

/// 곡. teamId는 "Line Up".id를 참조하는 FK (2026-09-19 정규화).
model Setlist {
  id                  BigInt              @id @default(autoincrement())
  teamId              BigInt?
  title               String
  singer              String?
  albumCoverUrl       String?             @map("album")
  youtubeUrl          String?             @map("youtube_url")
  /// 유튜브 추천 검토 상태 (PRD F011~F013). F013(수동 입력)은 항상 approved로 확정한다.
  youtubeReviewStatus YoutubeReviewStatus @default(pending) @map("youtube_review_status")
  team                LineUp?             @relation(fields: [teamId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_setlist_team")
  /// 배치 추천 검색 시도 이력 (PRD F011/F012). 역방향 관계라 DB 스키마에는 영향이 없다.
  searchAttempts      YoutubeSearchAttempt[]
}

/// 유튜브 추천 검토 상태. text 대신 enum을 쓴 이유는 Prisma가 TS 유니온 타입을 생성해
/// 상태 전이 코드가 컴파일 타임에 검증되고, 값 오타가 DB에 닿기 전에 걸리기 때문이다.
/// 값 추가는 ALTER TYPE ADD VALUE로 가능하지만 제거/개명은 어렵다 — PRD가 정한 닫힌 집합이라 감수한다.
enum YoutubeReviewStatus {
  pending
  approved
  rejected

  @@map("youtube_review_status")
}

/// 배치 추천 검색 1회의 결과 (PRD F011).
/// reserved는 "외부 호출 직전에 예약됨" — 호출 전에 커밋해 두어야 크래시가 나도
/// 그 행이 남아 일일 쿼터 집계에 포함된다. 쿼터를 적게 세는 쪽이 더 위험하다.
enum YoutubeSearchOutcome {
  reserved
  searched
  no_results
  failed

  @@map("youtube_search_outcome")
}

/// 추천 리뷰 진행 상태 (PRD F012).
/// closed는 "리뷰 대상이 아님"(볼 후보가 존재하지 않음)이며 reserved/no_results/failed가 갖는 값이다.
/// expired는 30일 경과로 후보가 정리된 상태 — YouTube 개발자 정책의 보관 제한 대응.
enum YoutubeReviewState {
  open
  approved
  rejected
  superseded
  expired
  closed

  @@map("youtube_review_state")
}

/// 곡 하나에 대한 배치 추천 검색 시도 (PRD F011).
///
/// 후보와 테이블을 나눈 이유: 곡당 후보 N행짜리 단일 테이블로는 "검색했는데 결과 0건"을
/// 표현할 행이 없어, 6단계 1/2이 남긴 "미검색 vs 검색됨·리뷰 대기" 구분 불가 한계를 못 푼다.
///
/// `completedAt`의 정의가 중요하다 — **외부 호출이 "이 곡에 대한 판정"으로 귀결된 시각**이다.
/// 타임아웃·업스트림 5xx·JSON 파싱 실패는 판정이므로 채운다. 반대로 쿼터 초과·API 키 오류·
/// 프로세스 크래시는 이 곡을 평가조차 하지 못한 것이므로 NULL로 둔다.
/// 그래서 `outcome = failed AND completedAt IS NULL`이 "곡 탓이 아닌 실패"를 뜻하고,
/// 곡별 연속 실패수(배치 제외 판정)에서 제외된다. 일일 쿼터 집계에는 둘 다 포함된다.
model YoutubeSearchAttempt {
  id              BigInt                  @id @default(autoincrement())
  songId          BigInt
  /// 실제로 보낸 검색어. 우리 입력이라 30일 보관 제한 대상이 아니다.
  query           String
  /// 예약 시각 = 일일 쿼터 집계의 유일한 원천. 태평양 시간 자정 경계로 센다.
  searchedAt      DateTime                @default(now()) @db.Timestamptz(6)
  completedAt     DateTime?               @db.Timestamptz(6)
  outcome         YoutubeSearchOutcome    @default(reserved)
  reviewState     YoutubeReviewState      @default(closed)
  candidateCount  Int                     @default(0) @db.SmallInt
  /// 승인한 후보의 등수. 후보 행은 승인 시점에 삭제되므로 참조 대상이 없는 기록값이다.
  approvedRank    Int?                    @db.SmallInt
  rejectedReason  String?
  reviewedAt      DateTime?               @db.Timestamptz(6)
  /// 곡 제목·가수가 실제로 바뀌었거나 관리자가 재큐하면 찍힌다. 찍힌 행은 배치 선정의
  /// 제외 판단에 쓰이지 않는다(= 곡이 대상으로 복귀한다). 쿼터 집계에는 계속 포함된다.
  invalidatedAt   DateTime?               @db.Timestamptz(6)
  song            Setlist                 @relation(fields: [songId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  recommendations YoutubeRecommendation[]

  @@index([songId, searchedAt(sort: Desc)])
  @@index([reviewState])
  @@index([searchedAt])
}

/// 시도 하나가 찾아낸 후보 영상 (PRD F012).
///
/// **리뷰가 끝나는 순간(approved/rejected/superseded/expired) 전량 삭제된다.**
/// YouTube 개발자 정책이 비인증 API 데이터의 보관을 30일로 제한하고 이후 삭제 또는 갱신을
/// 요구하기 때문이다(해석은 구현자의 것이며 법적 확인을 받지 않았다 — REFACTOR_NOTES 참조).
/// 그래서 YouTube가 준 문자열은 이 테이블에만 있고, 승인된 videoId는 Setlist.youtube_url로만 옮겨간다.
model YoutubeRecommendation {
  id           BigInt               @id @default(autoincrement())
  attemptId    BigInt
  rank         Int                  @db.SmallInt
  score        Int
  videoId      String
  title        String
  channelTitle String
  thumbnailUrl String
  attempt      YoutubeSearchAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([attemptId, rank])
}

/// 공연장 정보의 단일 출처. 공개 사이트에는 anon SELECT만 허용한다.
model Venue {
  id            BigInt    @id @default(autoincrement())
  name          String
  address       String
  addressDetail String?
  latitude      Decimal   @db.Decimal(9, 6)
  longitude     Decimal   @db.Decimal(9, 6)
  naverMapUrl   String?
  websiteUrl    String?
  updatedAt     DateTime  @default(now()) @updatedAt @db.Timestamptz(6)
  concerts      Concert[]
}

/// 현재 공연 한 건. DB의 Concert_singleton CHECK가 id = 1을 강제한다.
/// Concert_dateRange CHECK가 endDate >= startDate를 강제한다. CHECK는 Prisma가 표현하지 못한다.
model Concert {
  id               BigInt   @id
  titleKo          String
  titleEn          String
  subtitle         String?
  startDate        DateTime @db.Date
  endDate          DateTime @db.Date
  showTime         String
  posterImageUrl   String?
  titleImageUrl    String?
  subtitleImageUrl String?
  venueId          BigInt
  updatedAt        DateTime @default(now()) @updatedAt @db.Timestamptz(6)
  venue            Venue    @relation(fields: [venueId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "Concert_venueId_fkey")
}

/// 일차별 공연. dayKey는 기존 LineUp.day와 같은 day1·day2 식별값이다.
model PerformanceDay {
  id                BigInt   @id @default(autoincrement())
  dayKey            String   @unique(map: "PerformanceDay_dayKey_key")
  dayLabel          String
  dateLabel         String
  bookingUrl        String?
  lineupOverride    String?
  timetableImageUrl String?
  updatedAt         DateTime @default(now()) @updatedAt @db.Timestamptz(6)
}

/// 티켓 안내 한 건. DB의 Ticket_singleton CHECK가 id = 1을 강제한다.
/// CHECK는 Prisma가 표현하지 못하므로 수작성 마이그레이션에서 관리한다.
model Ticket {
  id            BigInt   @id
  frontImageUrl String?
  backImageUrl  String?
  description   String?
  updatedAt     DateTime @default(now()) @updatedAt @db.Timestamptz(6)
}

/// 요금 안내·관람 유의사항의 구분.
enum InfoSectionCategory {
  ticket
  notice

  @@map("info_section_category")
}

/// 안내 섹션. DB의 UNIQUE는 DEFERRABLE INITIALLY DEFERRED로 순서 맞바꾸기를 허용한다.
/// Prisma는 지연 제약을 표현하지 못하므로 지연 속성은 수작성 마이그레이션에서 관리한다.
model InfoSection {
  id        BigInt              @id @default(autoincrement())
  category  InfoSectionCategory
  title     String
  sortOrder Int
  items     InfoItem[]

  @@unique([category, sortOrder], map: "InfoSection_category_sortOrder_key")
}

/// 섹션에 속한 안내 항목. 섹션 삭제 시 함께 삭제한다.
/// DB의 UNIQUE는 DEFERRABLE INITIALLY DEFERRED이며 Prisma는 지연 속성을 표현하지 못한다.
model InfoItem {
  id        BigInt      @id @default(autoincrement())
  sectionId BigInt
  content   String
  sortOrder Int
  section   InfoSection @relation(fields: [sectionId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "InfoItem_sectionId_fkey")

  @@unique([sectionId, sortOrder], map: "InfoItem_sectionId_sortOrder_key")
}
