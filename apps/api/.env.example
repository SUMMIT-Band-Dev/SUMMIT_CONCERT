# ── Supabase Postgres 직접 연결 ──────────────────────────────────────────────
# Supabase 대시보드 > Project Settings > Database > Connection string 에서 복사.
# PostgREST(anon key) 경유가 아니라 Postgres 프로토콜 직접 연결이어야 함.
# 연결 계정은 `postgres` — rolbypassrls=true + 테이블 소유자라 RLS를 우회한다
# (관리자 쓰기 작업이 SELECT 전용 RLS 정책에 막히지 않게 하기 위함).
#
# ⚠️ 이 파일은 커밋된다. 실제 값은 절대 여기에 쓰지 말고 .env에만 넣을 것.
# ⚠️ 대시보드가 보여주는 [YOUR-PASSWORD]의 대괄호는 placeholder 표시이므로 같이 지워야 한다.

# 런타임용. Session pooler(포트 5432) 사용 — IPv4 지원, 상주 서버에 적합.
# 형식: postgresql://postgres.<PROJECT_REF>:<PASSWORD>@aws-<N>-<REGION>.pooler.supabase.com:5432/postgres
DATABASE_URL=

# 마이그레이션용. Direct connection(db.<PROJECT_REF>.supabase.co:5432) 권장.
# 단 Free tier의 direct connection은 IPv6 전용이라 환경에 따라 접속이 안 될 수 있음 →
# 그 경우 DATABASE_URL과 동일한 Session pooler 문자열을 그대로 넣어도 마이그레이션 동작함.
DIRECT_URL=

# ── 인증 (JWT) ───────────────────────────────────────────────────────────────
# ⚠️ 여기(.env.example)가 아니라 .env에만 실제 값을 넣을 것. 이 파일은 커밋된다.
#
# 아래 명령으로 직접 생성해서 붙여넣는다 (64자 base64url = 384비트):
#   node -e "console.log(require('node:crypto').randomBytes(48).toString('base64url'))"
#
# 최소 32자 이상이어야 서버가 기동한다(미만이면 부팅 시 에러).
# 값을 바꾸면 이미 발급된 토큰은 전부 무효가 된다 — 사실상 유일한 강제 로그아웃 수단.
JWT_SECRET=

# 액세스 토큰 만료 시간. 미설정 시 기본 2h.
# refresh 토큰도, 서버측 토큰 무효화도 없는 MVP 구조라
# 이 값이 곧 "토큰이 유출됐을 때 살아있는 시간"이다 — 늘릴 때는 그 점을 감안할 것.
JWT_EXPIRES_IN=2h

# ── 서버 ─────────────────────────────────────────────────────────────────────
# Next.js 개발 서버가 3000을 쓰므로 3001 사용
PORT=3001

# ── Supabase Storage (카드뉴스 이미지 업로드, PRD F007) ──────────────────────
# ⚠️ 여기(.env.example)가 아니라 .env에만 실제 값을 넣을 것. 이 파일은 커밋된다.
#
# 프로젝트 URL. Supabase 대시보드 > Project Settings > Data API 의 Project URL.
# 형식: https://<PROJECT_REF>.supabase.co  (끝에 슬래시 없이)
SUPABASE_URL=

# Storage 쓰기용 secret 키. Settings > API Keys 에서 `sb_secret_...` 을 새로 발급한다.
#
# legacy service_role 키를 쓰지 않는 이유: 유출됐을 때 개별 폐기가 안 되고 레거시 키를
# 전부 비활성화해야 하는데, 그러면 공개 프론트가 쓰는 anon 키까지 같이 죽어 사이트가 내려간다.
# secret 키는 그 하나만 삭제하면 된다.
#
# ⚠️ RLS를 전부 우회하는 키다. 브라우저/프론트엔드에 절대 넣지 말 것
#    (Supabase가 브라우저 User-Agent를 감지하면 401로 거절한다).
# ⚠️ 미설정이면 서버가 기동하지 않는다 (JWT_SECRET과 같은 방침).
SUPABASE_SECRET_KEY=

# 카드뉴스 이미지를 담는 버킷 이름. 미설정 시 기본값 team-cards.
# 버킷 스펙: public 읽기 / file_size_limit 2MB / allowed_mime_types = image/jpeg, image/png, image/webp
# 쓰기 정책(INSERT/UPDATE/DELETE)은 만들지 않는다 — anon 키로는 쓰기 불가, 서버만 쓴다.
SUPABASE_STORAGE_BUCKET=team-cards

# ── YouTube Data API (배치 추천 검색, PRD F011) ──────────────────────────────
# ⚠️ 여기(.env.example)가 아니라 .env에만 실제 값을 넣을 것. 이 파일은 커밋된다.
#
# ⚠️ **프론트의 YOUTUBE_API_KEY(루트 .env.local)를 재사용하지 말 것.**
#    쿼터는 API 키가 아니라 **Cloud 프로젝트**에 귀속된다
#    (구글 문서: "the project associated with the API key is used as the quota project").
#    같은 프로젝트에서 키만 두 개 만들면 search.list의 일일 100회 버킷을 그대로 공유해서,
#    관리자 배치가 방문자 폴백의 쿼터를 잠식하는 것을 전혀 막지 못한다.
#    → 배치 전용 Cloud 프로젝트를 따로 만들고 거기서 발급한 키를 넣는다.
#
# 권장 키 제한: API 제한 = YouTube Data API v3 하나만.
#   애플리케이션 제한은 배포 위치가 정해진 뒤 서버 IP로 건다(7단계 항목).
#
# 앱은 하루 80회까지만 쓴다(할당량 100의 80%). 나머지 20회는 캘리브레이션·수동 재시도 여유분.
# 쿼터 리셋은 태평양 시간 자정("Daily quotas reset at midnight Pacific Time (PT)").
# ⚠️ 미설정이거나 20자 미만이면 서버가 기동하지 않는다 (JWT_SECRET·SUPABASE_SECRET_KEY와 같은 방침).
YOUTUBE_BATCH_API_KEY=
