# apps/admin 환경변수 규약
#
# ⚠️ 이 앱의 모든 NEXT_PUBLIC_* 값은 **브라우저 번들에 그대로 들어가 누구에게나 보인다.**
#    비밀값(토큰, 비밀번호, JWT_SECRET, DB URL, Supabase·YouTube 키 등)을 절대 넣지 말 것.
#    이 앱은 서버 전용 비밀값을 쓰지 않는다 — 인증은 로그인 후 받은 토큰을 브라우저가 들고 API에 보낸다.
# 실제 값은 apps/admin/.env.local(gitignore)에 둔다. 이 파일에는 설명과 빈 값만 둔다.

# 관리자 API(apps/api)의 기준 주소. **필수.** 스킴+호스트[:포트]만, 끝 슬래시·경로 없이.
#   로컬 개발 예) http://localhost:3001
#   배포 예)     https://api.example.com   (http는 로컬 루프백에서만 쓴다)
# 반대편 설정: API(apps/api)의 .env에서 CORS_ALLOWED_ORIGINS에 **admin의 오리진**이 들어 있어야 브라우저 호출이 통과한다.
#   로컬 개발) CORS_ALLOWED_ORIGINS=http://localhost:3010   배포) https://admin.example.com
# 값이 바뀌면 다시 빌드해야 한다(빌드 시점에 번들에 박힌다). CSP connect-src에도 같은 값이 쓰인다.
NEXT_PUBLIC_API_BASE_URL=

# 공개 사이트(summit-concert.live)의 오리진. 선택. 7c-2(팀 카드 미리보기)부터 사용한다.
#   기존 15팀의 image_src는 "/day1-team1.png" 같은 **공개 사이트 기준 상대경로**라, admin 오리진에서는 그대로 열리지 않는다.
#   이 값을 앞에 붙여 미리보기를 만든다. 스킴+호스트만, 끝 슬래시 없이. 예) https://summit-concert.live
NEXT_PUBLIC_PUBLIC_SITE_ORIGIN=

# Supabase Storage의 오리진. 7c-2b(카드 이미지 업로드)부터 사용한다.
#   업로드한 이미지의 cardImageUrl은 "https://<ref>.supabase.co/storage/v1/object/public/team-cards/..." 형태다.
#   **이 값을 넣어야 CSP img-src가 그 호스트를 허용해 미리보기가 보인다**(안 넣으면 이미지가 차단된다).
#   비밀값이 아니다 — 공개 버킷의 공개 URL 호스트이고, 같은 값이 공개 사이트에도 노출된다.
#   와일드카드(*.supabase.co)를 쓰지 않는 이유는 src/lib/csp.ts 주석 참조. 스킴+호스트만, 끝 슬래시 없이.
#   예) https://uhefeuskanwfzalykvex.supabase.co
NEXT_PUBLIC_SUPABASE_STORAGE_ORIGIN=

# 네이버 클라우드 Maps Application의 Client ID(공개 사이트 지도와 같은 값). 공연장 정보 페이지 지도에 사용한다.
#   공개 값이므로 브라우저 번들에 들어가도 되지만 Client Secret은 절대 넣지 않는다.
#   Geocoding은 API 서버가 Secret으로 호출한다.
#   NCP 콘솔 Web 서비스 URL에 관리자 오리진(로컬 http://localhost:3010, 배포 도메인)을 등록해야 한다.
#   비어 있으면 지도 없이 좌표 직접 입력만 가능하다. 값이 바뀌면 다시 빌드해야 한다.
NEXT_PUBLIC_NAVER_MAP_CLIENT_ID=
