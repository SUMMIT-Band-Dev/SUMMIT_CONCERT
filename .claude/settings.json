{
  "permissions": {
    "allow": ["Bash(git add *)", "Bash(git commit -m ' *)"],
    "deny": [],
    "ask": [],
    "defaultMode": "plan"
  },
  "hooks": {
    "Notification": [
      {
        "matcher": "",
        "hooks": [{ "type": "command", "command": "node .claude/hooks/notify-slack.js" }]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [{ "type": "command", "command": "node .claude/hooks/notify-slack.js" }]
      }
    ]
  }
}
